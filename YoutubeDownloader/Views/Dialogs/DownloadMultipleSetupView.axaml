<UserControl
    x:Class="YoutubeDownloader.Views.Dialogs.DownloadMultipleSetupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:converters="clr-namespace:YoutubeDownloader.Converters"
    xmlns:dialogs="clr-namespace:YoutubeDownloader.ViewModels.Dialogs"
    xmlns:md="using:Md3.Avalonia.Controls"
    x:Name="UserControl"
    Width="500"
    x:DataType="dialogs:DownloadMultipleSetupViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            Margin="16"
            FontSize="{DynamicResource Md.Sys.TypeScale.TitleLarge.Size}"
            FontWeight="Medium"
            Foreground="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
            Text="{Binding Title}"
            TextTrimming="CharacterEllipsis">
            <TextBlock.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CopyTitleCommand}" Header="{Binding LocalizationManager.CopyMenuItem}" />
                </ContextMenu>
            </TextBlock.ContextMenu>
        </TextBlock>

        <!--  Videos  -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}"
            BorderThickness="0,1">
            <ListBox
                ItemsSource="{Binding AvailableVideos}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItems="{Binding SelectedVideos}"
                SelectionMode="Multiple,Toggle">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding SelectAllCommand}" Header="{Binding LocalizationManager.SelectAllMenuItem}" />
                        <MenuItem Command="{Binding DeselectAllCommand}" Header="{Binding LocalizationManager.DeselectAllMenuItem}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.Styles>
                    <Style Selector="ListBox">
                        <Style Selector="^ ListBoxItem">
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.Medium}" />
                        </Style>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,8,0" ColumnDefinitions="Auto,*,Auto">
                            <!--  Thumbnail  -->
                            <Image
                                Grid.Column="0"
                                Width="48"
                                Height="48"
                                asyncImageLoader:ImageLoader.Source="{Binding Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" />

                            <!--  Info  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Orientation="Vertical"
                                Spacing="8">
                                <!--  Title  -->
                                <TextBlock
                                    FontSize="14"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding Title}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!--  Author  -->
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <md:MdIcon Size="16" Glyph="{x:Static md:MdSymbols.Person}" />
                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Author.Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!--  Duration  -->
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <md:MdIcon Size="16" Glyph="{x:Static md:MdSymbols.Schedule}" />
                                        <TextBlock
                                            FontSize="12"
                                            Text="{Binding Duration, TargetNullValue=Live}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!--  Checkmark  -->
                            <md:MdIcon
                                Grid.Column="2"
                                Size="24"
                                Margin="8,0,0,0"
                                Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}"
                                Glyph="{x:Static md:MdSymbols.Check}"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--  Preferences  -->
        <UniformGrid
            Grid.Row="2"
            Margin="8"
            Columns="2">
            <!--  Container preference  -->
            <md:MdComboBox
                Margin="8"
                ItemsSource="{Binding AvailableContainers}"
                Label="{Binding LocalizationManager.ContainerLabel}"
                SelectedItem="{Binding SelectedContainer}"
                Variant="Outlined" />

            <!--  Video quality preference  -->
            <md:MdComboBox
                Margin="8"
                IsEnabled="{Binding !SelectedContainer.IsAudioOnly}"
                ItemsSource="{Binding AvailableVideoQualityPreferences}"
                Label="{Binding LocalizationManager.VideoQualityLabel}"
                SelectedItem="{Binding SelectedVideoQualityPreference}"
                Variant="Outlined">
                <md:MdComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static converters:VideoQualityPreferenceToStringConverter.Instance}}" />
                    </DataTemplate>
                </md:MdComboBox.ItemTemplate>
            </md:MdComboBox>
        </UniformGrid>

        <!--  Buttons  -->
        <UniformGrid
            Grid.Row="3"
            Margin="8"
            Columns="2">
            <!--  Download  -->
            <md:MdButton
                Margin="8"
                Command="{Binding ConfirmCommand}"
                IsDefault="True"
                Variant="Filled">
                <md:MdButton.Content>
                    <TextBlock>
                        <Run Text="{Binding LocalizationManager.DownloadButton}" />
                        <Run Text="(" /><Run Text="{Binding SelectedVideos.Count, FallbackValue=0, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </md:MdButton.Content>
            </md:MdButton>

            <!--  Cancel  -->
            <md:MdButton
                Margin="8"
                Command="{Binding CloseCommand}"
                Content="{Binding LocalizationManager.CancelButton}"
                IsCancel="True"
                Variant="Outlined" />
        </UniformGrid>
    </Grid>
</UserControl>
