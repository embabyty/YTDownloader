<UserControl
    x:Class="YoutubeDownloader.Views.Dialogs.AuthSetupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:YoutubeDownloader.ViewModels.Dialogs"
    xmlns:md="using:Md3.Avalonia.Controls"
    Height="450"
    MinWidth="450"
    x:DataType="dialogs:AuthSetupViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            Margin="16"
            FontSize="{DynamicResource Md.Sys.TypeScale.TitleLarge.Size}"
            FontWeight="Medium"
            Foreground="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
            Text="{Binding LocalizationManager.AuthenticationTitle}" />

        <!--  Content  -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}"
            BorderThickness="0,1">
            <Panel>
                <!--  Current auth status  -->
                <StackPanel
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsAuthenticated}"
                    Orientation="Vertical"
                    Spacing="16">
                    <md:MdIcon
                        Size="128"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}"
                        Glyph="{x:Static md:MdSymbols.AccountCircle}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <Run FontWeight="Light" Text="{Binding LocalizationManager.AuthenticatedText}" />
                    </TextBlock>

                    <!--  Log out  -->
                    <md:MdButton
                        x:Name="LogOutButton"
                        HorizontalAlignment="Center"
                        Click="LogOutButton_OnClick"
                        Content="{Binding LocalizationManager.LogOutButton}"
                        Variant="Tonal" />
                </StackPanel>

                <!--  Placeholder  -->
                <TextBlock
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    IsVisible="{Binding !IsAuthenticated}"
                    Text="{Binding LocalizationManager.AuthenticationPlaceholderText}"
                    TextWrapping="Wrap" />

                <!--  Browser  -->
                <NativeWebView
                    x:Name="WebBrowser"
                    IsVisible="{Binding !IsAuthenticated}"
                    EnvironmentRequested="WebBrowser_OnEnvironmentRequested"
                    Loaded="WebBrowser_OnLoaded"
                    NavigationStarted="WebBrowser_OnNavigationStarted" />
            </Panel>
        </Border>

        <!--  Close button  -->
        <md:MdButton
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Stretch"
            Command="{Binding CloseCommand}"
            Content="{Binding LocalizationManager.CloseButton}"
            IsCancel="True"
            IsDefault="True"
            Variant="Outlined" />
    </Grid>
</UserControl>
