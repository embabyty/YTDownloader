<UserControl
    x:Class="YoutubeDownloader.Views.Dialogs.DownloadSingleSetupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:converters="clr-namespace:YoutubeDownloader.Converters"
    xmlns:dialogs="clr-namespace:YoutubeDownloader.ViewModels.Dialogs"
    xmlns:md="using:Md3.Avalonia.Controls"
    x:Name="UserControl"
    Width="500"
    x:DataType="dialogs:DownloadSingleSetupViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!--  Info  -->
        <StackPanel
            Grid.Row="0"
            Margin="16"
            Orientation="Vertical"
            Spacing="8">
            <!--  Title  -->
            <TextBlock
                FontSize="{DynamicResource Md.Sys.TypeScale.TitleLarge.Size}"
                FontWeight="Medium"
                Foreground="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
                Text="{Binding Video.Title}"
                TextTrimming="CharacterEllipsis"
                ToolTip.Tip="{Binding Video.Title}">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding CopyTitleCommand}" Header="{Binding LocalizationManager.CopyMenuItem}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <!--  Author  -->
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <md:MdIcon Size="16" Glyph="{x:Static md:MdSymbols.Person}" />
                    <TextBlock
                        FontSize="12"
                        Text="{Binding Video.Author.Title}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Duration  -->
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <md:MdIcon Size="16" Glyph="{x:Static md:MdSymbols.Schedule}" />
                    <TextBlock
                        FontSize="12"
                        Text="{Binding Video.Duration, TargetNullValue=Live}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  Thumbnail  -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}"
            BorderThickness="0,1">
            <Image asyncImageLoader:ImageLoader.Source="{Binding Video, Converter={x:Static converters:VideoToHighestQualityThumbnailUrlStringConverter.Instance}}" />
        </Border>

        <!--  Download options  -->
        <md:MdComboBox
            Grid.Row="2"
            Margin="16"
            ItemsSource="{Binding AvailableDownloadOptions}"
            Label="{Binding LocalizationManager.FormatLabel}"
            SelectedItem="{Binding SelectedDownloadOption}"
            Variant="Outlined">
            <md:MdComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--  Video quality / audio-only label  -->
                            <TextBlock Classes.audioOnly="{Binding IsAudioOnly}" FontWeight="SemiBold">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{Binding VideoQuality, Mode=OneWay}" />

                                        <Style Selector="^.audioOnly">
                                            <Setter Property="Text" Value="{Binding #UserControl.DataContext.LocalizationManager.AudioLabel}" />
                                        </Style>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>

                            <!--  Upscaled badge  -->
                            <Border
                                Padding="6,1"
                                BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Md.Sys.Shape.Corner.Small}"
                                IsVisible="{Binding IsVideoUpscaled}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Text="{Binding #UserControl.DataContext.LocalizationManager.UpscaledLabel}" />
                            </Border>
                        </StackPanel>

                        <!--  Container  -->
                        <TextBlock FontSize="12" Text="{Binding Container, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </md:MdComboBox.ItemTemplate>
        </md:MdComboBox>

        <!--  Buttons  -->
        <UniformGrid
            Grid.Row="3"
            Margin="8"
            Columns="2">
            <!--  Download  -->
            <md:MdButton
                Margin="8"
                Command="{Binding ConfirmCommand}"
                Content="{Binding LocalizationManager.DownloadButton}"
                IsDefault="True"
                Variant="Filled" />

            <!--  Cancel  -->
            <md:MdButton
                Margin="8"
                Command="{Binding CloseCommand}"
                Content="{Binding LocalizationManager.CancelButton}"
                IsCancel="True"
                Variant="Outlined" />
        </UniformGrid>
    </Grid>
</UserControl>
